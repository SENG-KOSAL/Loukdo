generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(CASHIER)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id         String          @id @default(cuid())
  name       String          @unique
  code       String          @unique
  url        String?
  adminName  String?
  adminEmail String?
  status     BranchStatus    @default(ACTIVE)
  users      User[]
  sales      Sale[]
  products   Product[]
  categories Category[]
  vendors    Vendor[]
  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
  inventory  InventoryItem[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Product {
  id          String          @id @default(cuid())
  name        String
  description String?
  price       Decimal         @default(0)
  cost        Decimal         @default(0)
  sku         String?
  barcode     String?
  taxable     Boolean         @default(true)
  active      Boolean         @default(true)
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id])
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id])
  inventory   InventoryItem[]
  saleItems   SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements StockMovement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([sku, branchId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String
  desc      String?
  active    Boolean   @default(true)
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([slug, branchId])
}

model Sale {
  id        String     @id @default(cuid())
  receiptNo String?
  subtotal  Decimal    @default(0)
  tax       Decimal    @default(0)
  total     Decimal    @default(0)
  status    SaleStatus @default(COMPLETED)
  branchId  String
  branch    Branch     @relation(fields: [branchId], references: [id])
  items     SaleItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model SaleItem {
  id        String  @id @default(cuid())
  quantity  Int     @default(1)
  unitPrice Decimal @default(0)
  total     Decimal @default(0)
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([saleId, productId])
}

model InventoryItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(0)
  minStock  Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
}

model RolePermission {
  id         String   @id @default(cuid())
  role       Role
  permission String
  allowed    Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@unique([role, permission])
}

enum Role {
  SUPER_ADMIN
  BRANCH_ADMIN
  MANAGER
  CASHIER
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Vendor {
  id             String          @id @default(cuid())
  name           String
  code           String?
  contactName    String?
  email          String?
  phone          String?
  address        String?
  paymentTerms   String?
  notes          String?
  active         Boolean         @default(true)
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([name, branchId])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  poNumber       String
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime            @default(now())
  expectedDate   DateTime?
  receivedAt     DateTime?
  subtotal       Decimal             @default(0)
  tax            Decimal             @default(0)
  shipping       Decimal             @default(0)
  total          Decimal             @default(0)
  notes          String?
  vendorId       String
  vendor         Vendor              @relation(fields: [vendorId], references: [id])
  branchId       String
  branch         Branch              @relation(fields: [branchId], references: [id])
  createdById    String?
  createdBy      User?               @relation(fields: [createdById], references: [id])
  items          PurchaseOrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([poNumber, branchId])
}

model PurchaseOrderItem {
  id               String          @id @default(cuid())
  quantity         Int             @default(1)
  receivedQuantity Int             @default(0)
  unitCost         Decimal         @default(0)
  total            Decimal         @default(0)
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  stockMovements   StockMovement[]

  @@unique([purchaseOrderId, productId])
}

model StockMovement {
  id                  String             @id @default(cuid())
  type                StockMovementType
  status              StockMovementStatus @default(COMPLETED)
  quantity            Int
  quantityBefore      Int
  quantityAfter       Int
  note                String?
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  branchId            String
  branch              Branch             @relation(fields: [branchId], references: [id])
  purchaseOrderId     String?
  purchaseOrder       PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  createdById         String?
  createdBy           User?              @relation(fields: [createdById], references: [id])
  createdAt           DateTime           @default(now())

  @@index([branchId, createdAt])
  @@index([productId])
  @@index([purchaseOrderId])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE_RECEIPT
  PURCHASE_ORDER_STATUS
}

enum StockMovementStatus {
  PENDING
  COMPLETED
  CANCELLED
  REVERSED
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  VOID
}
