generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id         String       @id @default(cuid())
  name       String       @unique
  code       String       @unique
  url        String?
  adminName  String?
  adminEmail String?
  status     BranchStatus @default(ACTIVE)
  users      User[]
  sales      Sale[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Sale {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  total     Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
